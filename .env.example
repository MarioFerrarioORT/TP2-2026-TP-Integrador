PORT=8000
NODE_ENV=development
PERSISTENCE_TYPE=memory  # memory / sequelize
NOTIFIER_TYPE=console  # Notificaciones: console, file o both (consola y archivo)
SQLITE_STORAGE=database.sqlite
NOTIFICATIONS_LOG_PATH=notifications.log # Archivo donde escribe el notificador "file"

# --- Seguridad ---
# Generá un secreto largo y aleatorio: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
ADMIN_EMAIL=admin@gestor.com
ADMIN_PASSWORD=

# Reloj fijo para pruebas (dejar vacío para usar la hora real)
CLOCK_NOW=