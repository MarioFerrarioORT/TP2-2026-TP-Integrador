# Copiá este archivo como ".env" y completá los valores. El archivo ".env" NO se sube al repositorio.

# --- Servidor ---
PORT=8000
NODE_ENV=development

# --- Persistencia ---
# memory = datos en memoria (se pierden al reiniciar) | sequelize = base SQLite en un archivo
PERSISTENCE_TYPE=memory
# Archivo de la base (solo con PERSISTENCE_TYPE=sequelize)
SQLITE_STORAGE=database.sqlite

# --- Seguridad (obligatorias) ---
# Secreto para firmar los tokens JWT: usá un texto largo y propio
# Generá un secreto largo y aleatorio: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
# Administrador inicial: se crea al arrancar si no existe
ADMIN_EMAIL=admin@gestor.com
ADMIN_PASSWORD=cambiar-esta-clave

# --- Notificaciones ---
# console = por consola | file = a un archivo | both = ambas
NOTIFIER_TYPE=console
# Archivo del notificador "file"
NOTIFICATIONS_LOG_PATH=notifications.log

# --- Documentación ---
# Swagger UI en /api-docs. Si no se define: encendida, salvo con NODE_ENV=production
DOCS_ENABLED=true

# --- Pruebas ---
# Reloj fijo para probar fechas (ej. 2026-12-01T12:00:00Z). Vacío = hora real.
CLOCK_NOW=
