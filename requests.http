@baseUrl = http://localhost:8000

### 1. Login admin (200) — guarda el token
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "admin@gestor.com", "password": "passwordsecreto123" }

###
@adminToken = {{loginAdmin.response.body.$.token}}

### 2. Login con contraseña incorrecta (401 INVALID_CREDENTIALS)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "admin@gestor.com", "password": "incorrecta" }

### 3. Login con email inexistente (401, el MISMO error)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "nadie@gestor.com", "password": "incorrecta" }

### 4. Registro público (201) — el rol sale "usuario" aunque mandes "admin"
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "nombre": "Ana", "email": "ana@mail.com", "password": "clave12345", "rol": "admin" }

### 5. Login de Ana — guarda su token
# @name loginAna
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "ana@mail.com", "password": "clave12345" }

###
@anaToken = {{loginAna.response.body.$.token}}

### 6. Mi perfil sin token (401 TOKEN_MISSING)
GET {{baseUrl}}/auth/me

### 7. Mi perfil con token (200)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{anaToken}}

### 8. Token alterado (401 TOKEN_INVALID): cambiá una letra del token
GET {{baseUrl}}/auth/me
Authorization: Bearer {{anaToken}}x

### 9. Usuario común pide /users (403 FORBIDDEN)
GET {{baseUrl}}/users
Authorization: Bearer {{anaToken}}

### 10. Admin pide /users (200)
GET {{baseUrl}}/users
Authorization: Bearer {{adminToken}}

### 11. Admin se borra a sí mismo (409 CANNOT_DELETE_SELF)
DELETE {{baseUrl}}/users/1
Authorization: Bearer {{adminToken}}

### 12. Admin cambia el rol de Ana (200)
PATCH {{baseUrl}}/users/2/rol
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "rol": "admin" }
### 13. Registrar a Beto y Carla (201 cada una)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "nombre": "Beto", "email": "beto@mail.com", "password": "clave12345" }

###
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "nombre": "Carla", "email": "carla@mail.com", "password": "clave12345" }

### 14. Login de Beto y Carla (guardan su token)
# @name loginBeto
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "beto@mail.com", "password": "clave12345" }

###
@betoToken = {{loginBeto.response.body.$.token}}

###
# @name loginCarla
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "carla@mail.com", "password": "clave12345" }

###
@carlaToken = {{loginCarla.response.body.$.token}}

### 15. Ana crea un proyecto (201): ownerId y fechaCreacion salen del servidor
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Sitio web", "descripcion": "Rediseño", "fechaFin": "2026-12-31", "ownerId": 99 }

### 16. Fecha de fin en el pasado (400 INVALID_DATE_RANGE)
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Viejo", "fechaFin": "2020-01-01" }

### 17. Fecha con formato inválido (400 VALIDATION_ERROR)
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Nuevo", "fechaFin": "31/12/2026" }

### 18. Ana agrega a Beto por email (201, aparece en colaboradores)
POST {{baseUrl}}/projects/1/members
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "email": "beto@mail.com" }

### 19. Mismo email otra vez (409 ALREADY_COLLABORATOR)
POST {{baseUrl}}/projects/1/members
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "email": "beto@mail.com" }

### 20. Agregar a la propia dueña (409 OWNER_CANNOT_BE_COLLABORATOR)
POST {{baseUrl}}/projects/1/members
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "email": "ana@mail.com" }

### 21. Beto intenta agregar a Carla (403 NOT_PROJECT_OWNER)
POST {{baseUrl}}/projects/1/members
Content-Type: application/json
Authorization: Bearer {{betoToken}}

{ "email": "carla@mail.com" }

### 22. Beto ve el proyecto (200) / Carla no (403 NOT_PROJECT_MEMBER)
GET {{baseUrl}}/projects/1
Authorization: Bearer {{betoToken}}

###
GET {{baseUrl}}/projects/1
Authorization: Bearer {{carlaToken}}

### 23. Mis proyectos (200): Beto ve el de Ana porque es colaborador
GET {{baseUrl}}/projects
Authorization: Bearer {{betoToken}}

### 24. Beto intenta modificar (403) / Ana modifica (200)
PUT {{baseUrl}}/projects/1
Content-Type: application/json
Authorization: Bearer {{betoToken}}

{ "titulo": "Hack" }

###
PUT {{baseUrl}}/projects/1
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Sitio web 2.0" }

### 25. Ana quita a Beto (204) y otra vez (404 MEMBER_NOT_FOUND)
DELETE {{baseUrl}}/projects/1/members/3
Authorization: Bearer {{anaToken}}

### 26. El admin intenta borrar a Ana, dueña (409 USER_HAS_PROJECTS)
DELETE {{baseUrl}}/users/2
Authorization: Bearer {{adminToken}}

### 27. Ana elimina el proyecto (204)
DELETE {{baseUrl}}/projects/1
Authorization: Bearer {{anaToken}}

##################################################################

### 1. Login admin (200) — guarda el token
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "admin@gestor.com", "password": "passwordsecreto123" }

###
@adminToken = {{loginAdmin.response.body.$.token}}

### 5. Login de Ana — guarda su token
# @name loginAna
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "ana@mail.com", "password": "clave12345" }

###
@anaToken = {{loginAna.response.body.$.token}}

### 14. Login de Beto y Carla (guardan su token)
# @name loginBeto
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "beto@mail.com", "password": "clave12345" }

###
@betoToken = {{loginBeto.response.body.$.token}}

###
# @name loginCarla
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "carla@mail.com", "password": "clave12345" }

###
@carlaToken = {{loginCarla.response.body.$.token}}

####################################################################

### 28. Ana crea un proyecto para las pruebas de tareas
# @name proyecto7
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Proyecto con tareas", "fechaFin": "2026-12-31" }

###
@pid = {{proyecto7.response.body.$.id}}

### 29. Ana agrega a Beto como colaborador (201)
POST {{baseUrl}}/projects/{{pid}}/members
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "email": "beto@mail.com" }

### 30. Ana crea una tarea para Beto (201, estado "Pendiente" por defecto)
# @name tarea1
POST {{baseUrl}}/projects/{{pid}}/tasks
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Diseñar la home", "descripcion": "Mockups", "responsableId": 3 }

###
@tid = {{tarea1.response.body.$.id}}

### 31. Responsable que no participa: Carla (409 RESPONSIBLE_NOT_IN_PROJECT)
POST {{baseUrl}}/projects/{{pid}}/tasks
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Otra tarea", "responsableId": 4 }

### 32. Carla no participa, no puede crear tareas (403 NOT_PROJECT_MEMBER)
POST {{baseUrl}}/projects/{{pid}}/tasks
Content-Type: application/json
Authorization: Bearer {{carlaToken}}

{ "titulo": "Intruso", "responsableId": 2 }

### 33. Estado inválido (400) / sin responsable (400)
POST {{baseUrl}}/projects/{{pid}}/tasks
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Algo", "estado": "Hecho", "responsableId": 2 }

###
POST {{baseUrl}}/projects/{{pid}}/tasks
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Algo" }

### 34. Beto (colaborador) lista las tareas (200) y filtra por estado
GET {{baseUrl}}/projects/{{pid}}/tasks
Authorization: Bearer {{betoToken}}

###
GET {{baseUrl}}/projects/{{pid}}/tasks?estado=En%20proceso
Authorization: Bearer {{betoToken}}

### 35. Beto cambia el estado de su tarea (200)
PUT {{baseUrl}}/projects/{{pid}}/tasks/{{tid}}
Content-Type: application/json
Authorization: Bearer {{betoToken}}

{ "estado": "En proceso" }

### 36. Reasignar a alguien que no participa (409)
PUT {{baseUrl}}/projects/{{pid}}/tasks/{{tid}}
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "responsableId": 4 }

### 37. Reglas de baja con la tarea de Beto todavía asignada (los tres dan 409)
DELETE {{baseUrl}}/projects/{{pid}}/members/3
Authorization: Bearer {{anaToken}}

###
DELETE {{baseUrl}}/projects/{{pid}}
Authorization: Bearer {{anaToken}}

###
DELETE {{baseUrl}}/users/3
Authorization: Bearer {{adminToken}}

### 38. Beto no es dueño, no puede eliminar tareas (403 NOT_PROJECT_OWNER)
DELETE {{baseUrl}}/projects/{{pid}}/tasks/{{tid}}
Authorization: Bearer {{betoToken}}

### 39. Ana elimina la tarea (204) y otra vez (404 TASK_NOT_FOUND)
DELETE {{baseUrl}}/projects/{{pid}}/tasks/{{tid}}
Authorization: Bearer {{anaToken}}

###
DELETE {{baseUrl}}/projects/{{pid}}/tasks/{{tid}}
Authorization: Bearer {{anaToken}}

### 40. Sin tareas, ahora sí se puede quitar a Beto (204) y borrar el proyecto (204)
DELETE {{baseUrl}}/projects/{{pid}}/members/3
Authorization: Bearer {{anaToken}}

###
DELETE {{baseUrl}}/projects/{{pid}}
Authorization: Bearer {{anaToken}}

#########################################################################

### 41. Ana crea un proyecto para probar eventos
# @name proyecto8
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Proyecto de eventos", "fechaFin": "2026-12-31" }

###
@pid8 = {{proyecto8.response.body.$.id}}

### 42. Agregar a Beto (201) → consola: "Nuevo colaborador — Beto ... por Ana"
POST {{baseUrl}}/projects/{{pid8}}/members
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "email": "beto@mail.com" }

### 43. Agregarlo otra vez (409) → la consola NO muestra nada
POST {{baseUrl}}/projects/{{pid8}}/members
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "email": "beto@mail.com" }

### 44. Crear tarea para Beto (201) → consola: "Tarea asignada — ... por Ana"
# @name tarea8
POST {{baseUrl}}/projects/{{pid8}}/tasks
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Preparar entrega", "responsableId": 3 }

###
@tid8 = {{tarea8.response.body.$.id}}

### 45. Responsable que no participa (409) → la consola NO muestra nada
POST {{baseUrl}}/projects/{{pid8}}/tasks
Content-Type: application/json
Authorization: Bearer {{anaToken}}

{ "titulo": "Otra", "responsableId": 4 }

### 46. Cambiar solo el estado (200) → NO se notifica
PUT {{baseUrl}}/projects/{{pid8}}/tasks/{{tid8}}
Content-Type: application/json
Authorization: Bearer {{betoToken}}

{ "estado": "En proceso" }

### 47. Reasignar a Ana (200) → consola: "Tarea asignada ... a Ana ... por Beto"
PUT {{baseUrl}}/projects/{{pid8}}/tasks/{{tid8}}
Content-Type: application/json
Authorization: Bearer {{betoToken}}

{ "responsableId": 2 }